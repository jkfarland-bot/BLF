module

public import BLF.Small

@[expose] public section

/-! Data for n = 1, generated by scripts/gen_small.py; every fact is rechecked by the kernel. -/

namespace BLF

namespace N1

def allQ : List Quad := []

def consTable : List (ℕ × List Quad) := []

def cons (k : ℕ) : List Quad := ((consTable.find? (·.1 == k)).map (·.2)).getD []

def order : List ℕ := []

def bnd (k : ℕ) : ℕ := (List.range 1).countP (fun i => k.testBit i) - 1

def wits : List Wit := [([false, false], 0, 0, [0])]

end N1

end BLF
